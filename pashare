#!/bin/sh
# Share the default output's monitor as raw 48k s16le stereo over TCP. No auth.
# Usage: pashare start [port]|stop   (port defaults to 8000; needs pactl >= 15)
case "$1" in
  start)
    pactl unload-module module-simple-protocol-tcp 2>/dev/null
    pactl load-module module-simple-protocol-tcp rate=48000 format=s16le channels=2 source="$(pactl get-default-sink).monitor" record=true port="${2:-8000}"
    ;;
  stop)
    pactl unload-module module-simple-protocol-tcp
    ;;
  *)
    echo "Usage: $0 start [port]|stop" >&2
    exit 1
    ;;
esac
