#!/bin/sh
# Update all git repos in directory tree
dir=${1:-"."}
results=$(mktemp)
trap 'rm -f "$results"' EXIT
echo "Updating repos in: $dir"
find "$dir" -name .git -type d -prune -print0 2>/dev/null |
	xargs -0 -P 8 -I{} "$(dirname "$0")/git-update-worker.sh" {} "$results"
conflicts=$(grep -c "^REBASE_CONFLICT:" "$results")
echo "CHANGES:"
sed -n 's/^UPDATED://p' "$results" | while IFS='|' read -r repo changelog; do
	repo_name=${repo#"$dir"/}
	printf '\033[32m%s:\033[0m\n' "$repo_name"
	printf '%s\n' "$changelog" | tr ';' '\n' | sed 's/^/  /' | sed 's/^  $//'
done
if [ "$conflicts" -gt 0 ]; then
	printf '\033[31mREBASE CONFLICTS:\033[0m\n'
	sed -n 's/^REBASE_CONFLICT://p' "$results" | while IFS='|' read -r repo _; do
		repo_name=${repo#"$dir"/}
		printf '\033[31m%s: requires manual resolution\033[0m\n' "$repo_name"
	done
	notify-send "Git Rebase Conflicts" "$conflicts repos need manual resolution" -u critical -t 10000
fi
