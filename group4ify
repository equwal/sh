#!/bin/sh
# Recompress every page of a scanned PDF as bilevel CCITT Group 4 (via group4ify-aux).
# Usage: group4ify FILE.pdf   (writes ./FILE.pdf-group4.pdf)
set -e
TEMP="$(mktemp -d)"
trap 'rm -r "$TEMP"' EXIT
OUT="$PWD/$(basename "$1")-group4.pdf"
pdfseparate "$1" "$TEMP"/%d.pdf

cd "$TEMP"
for p in *.pdf; do group4ify-aux "$p"; done
# shellcheck disable=SC2046 # page files are N.pdf-group4.pdf: no spaces
pdfunite $(printf '%s\n' *-group4.pdf | sort -n) "$OUT"
