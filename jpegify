#!/bin/sh
# Shrink a PDF by re-rendering every page as a JPEG (via jpegify-aux).
# Usage: jpegify FILE.pdf   (writes ./FILE.pdf-jpeg.pdf)
set -e
TEMP="$(mktemp -d)"
trap 'rm -r "$TEMP"' EXIT
OUT="$PWD/$(basename "$1")-jpeg.pdf"
pdfseparate "$1" "$TEMP"/%d.pdf

cd "$TEMP"
for p in *.pdf; do jpegify-aux "$p"; done
# shellcheck disable=SC2046 # page files are N.pdf-jpeg.pdf: no spaces
pdfunite $(printf '%s\n' *-jpeg.pdf | sort -n) "$OUT"
