#!/bin/sh
# Pomodoro timer. Usage: pomodoro [-s [profile] | -k | -g]; no args opens a dmenu menu.
# -g prints "profile mm:ss" and advances the timer: poll it from a status bar.

remaining() {
  if [ -e "$statusfile" ]; then
    stime=$(awk '$1 == "start" {print $2}' "$statusfile")
    time=$(awk -v p="$(current)" '$1 == p {print $2}' "$configfile")
    echo $((stime - $(date +%s) + time))
  fi
}

current() {
  ! [ -e "$statusfile" ] && echo "null" || awk '$1 == "current" {print $2}' "$statusfile"
}

next() {
  awk -v p="$(current)" '$1 == p {print $3}' "$configfile"
}

update() {
  printf "current %s\nstart %s" "$1" "$(date +%s)" > "$statusfile"
}

list() {
  awk '{print $1}' "$configfile"
}

configdir="${XDG_CONFIG_HOME:-$HOME/.config}/pomodoro"
configfile="$configdir/config"
statusfile="${XDG_RUNTIME_DIR:-/tmp}/.pomodoro-$(id -u)"

# Check for config file, if it doesnt exist, copy the default.
if ! [ -e "$configfile" ]; then
  mkdir -p "$configdir"
  printf 'work 1500 break\nbreak 300 work\n' > "$configfile"
fi

# Set flags for the arguments.
while getopts ":sgk" opt; do
  case $opt in
    s)
      s=0
      ;;
    k)
      k=0
      ;;
    g)
      g=0
      ;;
    \?)
      exit 1
  esac
done

# If no input arguments, show a simple menu.
if [ $# -le 0 ]; then 
  selection=$(printf "start\nkill" | dmenu)
  [ $? -ne 0 ] && exit
  [ "$selection" = "start" ] && s=0 || k=0
fi
shift $((OPTIND - 1))

# Handlers.
if [ "$s" ]; then
  if [ $# -le 0 ]; then
    profile=$(list | dmenu)
    [ $? -ne 0 ] && exit
  else
    profile=$1
  fi
  list | grep -qxF -- "$profile" || exit 1
  update "$profile"
fi

[ "$k" ] && rm -f "$statusfile"

if [ "$g" ]; then
  [ "$(current)" = "null" ] && exit 1
  r=$(remaining)
  if [ "$r" -le 0 ]; then
    notify-send "Timer $(current)" "done"
    update "$(next)"
    "$0" -g
  else
    printf "%s %02d:%02d\n" "$(current)" $((r / 60)) $((r % 60))
  fi
fi
